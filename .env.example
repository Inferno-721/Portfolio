# Supabase Configuration
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Clerk Authentication
PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here
ADMIN_USER_IDs=your_clerk_admin_user_id_here

# Instructions:
# 1. Replace all "your_*_here" values with your actual credentials
# 2. Never commit this file to Git (it's already in .gitignore)
# 3. For Supabase credentials, visit: https://app.supabase.com/project/_/settings/api
# 4. For Clerk credentials, visit: https://dashboard.clerk.com/
# 5. Multiple admin IDs can be comma-separated: user_abc123,user_def456
