# Powers the "Ask my AI" agent. Gemini is used if set, then Claude.
# With neither key, the agent answers from search, with no model.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Defaults to gemini-3.5-flash-lite on Gemini and claude-opus-5-5 on Claude.
AGENT_MODEL=

# Only for `pnpm posts:sync`. Add it as a GitHub Actions secret for the automatic sync.
APIFY_TOKEN=
