---
import { skills } from "@cv";
import PaperCard from "@/shared/ui/paper-card.astro";
---

<ul class="grid gap-4 md:grid-cols-2">
  {
    skills.map(({ category, items }, index) => (
      <li data-reveal style={`--i: ${index % 2}`}>
        <PaperCard seed={index + 41} tilt="subtle">
          <h3 class="font-display text-lg font-semibold">{category}</h3>
          <ul class="mt-3 flex flex-wrap gap-2">
            {items.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
        </PaperCard>
      </li>
    ))
  }
</ul>
