---
import { education } from "@cv";
import { formatDateRange } from "@/shared/format-date-range";
import PaperCard from "@/shared/ui/paper-card.astro";
---

<ul class="space-y-4">
  {
    education.map(
      ({ institution, url, degree, startDate, endDate, note }, index) => (
        <li data-reveal>
          <PaperCard seed={index + 61} tilt="subtle">
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <h3 class="font-display text-lg font-semibold">
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="press hover:text-primary"
                >
                  {institution}
                </a>
              </h3>
              <p class="shrink-0 font-mono text-xs text-muted">
                {formatDateRange(startDate, endDate)}
              </p>
            </div>
            <p class="mt-1 text-muted">
              {degree}. {note}.
            </p>
          </PaperCard>
        </li>
      ),
    )
  }
</ul>
