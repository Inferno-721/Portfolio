---
import { achievements } from "@cv";
import PaperCard from "@/shared/ui/paper-card.astro";
---

<ul class="grid gap-4 md:grid-cols-2">
  {
    achievements.map(({ title, detail, date }, index) => (
      <li data-reveal style={`--i: ${index}`}>
        <PaperCard seed={index + 51}>
          <p class="font-mono text-xs text-primary">{date}</p>
          <h3 class="mt-2 font-display text-lg font-semibold">{title}</h3>
          <p class="mt-2 text-muted">{detail}</p>
        </PaperCard>
      </li>
    ))
  }
</ul>
