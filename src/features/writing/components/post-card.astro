---
import { Icon } from "astro-icon/components";
import PaperCard from "@/shared/ui/paper-card.astro";
import type { Post } from "../types.ts";

type Props = {
  post: Post;
  seed: number;
};

const { post, seed } = Astro.props;
const date = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(post.publishedAt));
---

<article class="h-full">
  <PaperCard seed={seed} flush>
    {
      post.image && (
        <img
          src={post.image}
          alt=""
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer"
          class="aspect-video w-full rounded-t-lg object-cover"
        />
      )
    }
    <div class="p-4 md:p-6">
      <header
        class="flex items-center justify-between gap-3 font-mono text-xs text-muted"
      >
        <span class="flex items-center gap-2">
          <Icon
            name={post.source === "linkedin" ? "linkedin" : "medium"}
            class="text-primary"
            size={14}
            aria-hidden="true"
          />
          {post.sourceName}
        </span>
        <time datetime={post.publishedAt}>{date}</time>
      </header>
      {
        post.title && (
          <h3 class="mt-3 font-display text-lg font-semibold group-hover:text-primary">
            {post.title}
          </h3>
        )
      }
      <p class="mt-2 line-clamp-4 whitespace-pre-line text-sm text-muted">
        {post.excerpt}
      </p>
      <footer
        class="mt-4 flex items-center justify-between gap-3 font-mono text-xs text-muted"
      >
        <span>
          {post.reactions !== null && `${post.reactions} reactions`}
          {post.comments !== null && ` · ${post.comments} comments`}
        </span>
        <a
          href={post.url}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-1 after:absolute after:inset-0 hover:text-ink"
        >
          Read
          <Icon
            name="arrow-up-right"
            class="nudge"
            size={14}
            aria-hidden="true"
          />
          <span class="sr-only">on {post.sourceName}</span>
        </a>
      </footer>
    </div>
  </PaperCard>
</article>
