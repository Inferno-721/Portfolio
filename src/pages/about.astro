---
import {
  AchievementList,
  EducationList,
  SkillTable,
} from "@/features/credentials";
import { ExperienceTimeline } from "@/features/experience";
import { AboutHeading, ContactBand, Principles } from "@/features/profile";
import SiteLayout from "./_site-layout.astro";
import Section from "@/shared/ui/section.astro";
---

<SiteLayout
  title="About"
  description="Shubham Joshi's AI engineering experience, and how they build multi-agent LLM systems that hold up in production."
>
  <AboutHeading />
  <Section
    title="How I build AI systems"
    lede="What building agents in production has taught me."
  >
    <Principles />
  </Section>
  <Section title="Experience">
    <ExperienceTimeline />
  </Section>
  <Section title="Toolbox">
    <SkillTable />
  </Section>
  <Section title="Recognition and education">
    <div class="space-y-4">
      <AchievementList />
      <EducationList />
    </div>
  </Section>
  <ContactBand />
</SiteLayout>
