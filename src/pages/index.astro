---
import { HowItWorks } from "@/features/agent";
import { ExperienceSummary } from "@/features/experience";
import { ContactBand, Hero, ProofStrip } from "@/features/profile";
import { ProjectList } from "@/features/projects";
import { LatestPosts } from "@/features/writing";
import SiteLayout from "./_site-layout.astro";
import Section from "@/shared/ui/section.astro";
---

<SiteLayout>
  <Hero />
  <ProofStrip />
  <Section
    title="How this site's AI works"
    lede="I build production agents for a living, so this site runs one. Same principles, smaller scale."
    moreHref="https://github.com/Inferno-721/Portfolio/tree/main/src/features/agent"
    moreLabel="Read the code"
  >
    <HowItWorks />
  </Section>
  <Section title="Selected work" moreHref="/projects" moreLabel="All projects">
    <ProjectList variant="featured" />
  </Section>
  <Section title="Latest writing" moreHref="/writing" moreLabel="All posts">
    <LatestPosts />
  </Section>
  <Section title="Experience" moreHref="/about" moreLabel="Full history">
    <ExperienceSummary />
  </Section>
  <ContactBand />
</SiteLayout>
