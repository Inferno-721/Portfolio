---
import { Icon } from "astro-icon/components";

type Props = {
  href: string;
  icon?: string;
  variant?: "primary" | "quiet";
  newTab?: boolean;
  download?: string;
};

const { href, icon, variant = "quiet", newTab = false, download } = Astro.props;
---

<a
  href={href}
  target={newTab ? "_blank" : undefined}
  rel={newTab ? "noopener noreferrer" : undefined}
  download={download}
  data-magnetic
  class:list={[
    "inline-flex h-control items-center gap-2 rounded-full px-4 text-sm font-medium",
    variant === "primary"
      ? "bg-primary text-primary-text hover:bg-primary-hover"
      : "glass hover:bg-raised",
  ]}
>
  {icon && <Icon name={icon} size={16} aria-hidden="true" />}
  <slot />
</a>
